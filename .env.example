# Cloud Configuration Source (e.g., GitHub Raw URL where your JSONs live)
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com/your-org/n8n-configs/main

# APIs (Never hardcoded in the workflow)
BRIGHTDATA_API_KEY=your_brightdata_api_token
HUNTER_API_KEY=your_hunter_api_token

# Enterprise Cloud Storage & Checkpointing
GOOGLE_SHEET_ID=1A2B3C4D5E6F7G8H9I0J
GOOGLE_DRIVE_FOLDER_ID=0B1C2D3E4F5G6H7I8J9
DATASTORE_NAME=mh_agri_leads_state

# Pipeline Performance & Limits
BATCH_SIZE=50
CONCURRENCY=2
POLL_INTERVAL=10000
MAX_RETRIES=5
OUTPUT_FORMAT=google_sheets # Options: google_sheets, excel, csv
LOG_LEVEL=info # Options: debug, info, warn, error