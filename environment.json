{
  "metadata": {
    "version": "1.1.0",
    "encoding": "UTF-8",
    "description": "All configuration settings consumed by the n8n pipeline. Manage these in this file on your GitHub repository rather than using restricted process environment variables.",
    "neverHardcodeSecrets": false
  },
  "variables": [
    {
      "key": "BRIGHTDATA_API_TOKEN",
      "description": "Bright Data API Bearer token. Configured in your n8n credentials.",
      "required": true,
      "secret": true,
      "exampleValue": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "key": "BRIGHTDATA_USERNAME",
      "description": "Proxy username. Sourced from brightdata.com.",
      "required": true,
      "secret": false,
      "exampleValue": "brd-customer-12345678"
    },
    {
      "key": "BRIGHTDATA_PASSWORD",
      "description": "Proxy zone password. Sourced from brightdata.com.",
      "required": true,
      "secret": true,
      "exampleValue": "xxxxxxxxxxxxxxxx"
    },
    {
      "key": "HUNTER_API_KEY",
      "description": "Hunter.io API key. Found at hunter.io.",
      "required": true,
      "secret": true,
      "exampleValue": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "key": "GOOGLE_SHEET_ID",
      "description": "Spreadsheet ID used for Google Sheets lead storage.",
      "required": true,
      "secret": false,
      "exampleValue": "1A2B3C4D5E6F7G8H9I0J"
    },
    {
      "key": "GOOGLE_SHEET_TAB_NAME",
      "description": "Tab name in Google Sheets.",
      "required": true,
      "secret": false,
      "exampleValue": "MH Agri Leads"
    },
    {
      "key": "GOOGLE_DRIVE_FOLDER_ID",
      "description": "Folder ID in Google Drive where Excel/CSV outputs are stored.",
      "required": true,
      "secret": false,
      "exampleValue": "0B1C2D3E4F5G6H7I8J9"
    }
  ],
  "values": {
    "GOOGLE_SHEET_ID": "1A2B3C4D5E6F7G8H9I0J",
    "GOOGLE_SHEET_TAB_NAME": "MH Agri Leads",
    "GOOGLE_DRIVE_FOLDER_ID": "0B1C2D3E4F5G6H7I8J9",
    "HUNTER_API_KEY": "your_hunter_api_token",
    "BRIGHTDATA_USERNAME": "your_brightdata_username",
    "BRIGHTDATA_PASSWORD": "your_brightdata_password"
  }
}
