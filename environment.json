{
  "metadata": {
    "version": "1.0.0",
    "encoding": "UTF-8",
    "description": "All environment variables consumed by this n8n pipeline. Set these in n8n Settings → Environment Variables or your Docker environment.",
    "neverHardcodeSecrets": true
  },
  "variables": [
    {
      "key": "BRIGHTDATA_API_TOKEN",
      "description": "Bright Data API Bearer token. Found at brightdata.com → Account → API Tokens.",
      "required": true,
      "secret": true,
      "exampleValue": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "key": "BRIGHTDATA_CUSTOMER_ID",
      "description": "Your Bright Data customer ID (numeric). Found in Account → Settings.",
      "required": true,
      "secret": false,
      "exampleValue": "12345678"
    },
    {
      "key": "BRIGHTDATA_USERNAME",
      "description": "Proxy username. Format: brd-customer-XXXXXXXX. Found in zone Access Parameters.",
      "required": true,
      "secret": false,
      "exampleValue": "brd-customer-12345678"
    },
    {
      "key": "BRIGHTDATA_PASSWORD",
      "description": "Proxy zone password. Found in zone Access Parameters.",
      "required": true,
      "secret": true,
      "exampleValue": "xxxxxxxxxxxxxxxx"
    },
    {
      "key": "BRIGHTDATA_SERP_ZONE",
      "description": "Name of your Bright Data SERP API zone.",
      "required": true,
      "secret": false,
      "defaultValue": "serp_api1",
      "exampleValue": "serp_api1"
    },
    {
      "key": "BRIGHTDATA_MAPS_DATASET_ID",
      "description": "Bright Data Web Scraper IDE dataset ID for Google Maps.",
      "required": true,
      "secret": false,
      "defaultValue": "gd_l7q7dkf244hwjntr0",
      "exampleValue": "gd_l7q7dkf244hwjntr0"
    },
    {
      "key": "BRIGHTDATA_UNLOCKER_ZONE",
      "description": "Name of your Bright Data Web Unlocker zone for website scraping.",
      "required": true,
      "secret": false,
      "defaultValue": "web_unlocker1",
      "exampleValue": "web_unlocker1"
    },
    {
      "key": "BRIGHTDATA_UNLOCKER_HOST",
      "description": "Bright Data proxy host. Do not change unless instructed by Bright Data.",
      "required": true,
      "secret": false,
      "defaultValue": "brd.superproxy.io",
      "exampleValue": "brd.superproxy.io"
    },
    {
      "key": "BRIGHTDATA_UNLOCKER_PORT",
      "description": "Bright Data proxy port.",
      "required": true,
      "secret": false,
      "defaultValue": "22225",
      "exampleValue": "22225"
    },
    {
      "key": "HUNTER_API_KEY",
      "description": "Hunter.io API key. Found at hunter.io → Dashboard → API.",
      "required": true,
      "secret": true,
      "exampleValue": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "key": "PIPELINE_OUTPUT_DIR",
      "description": "Directory path where CSV/Excel exports are saved.",
      "required": false,
      "secret": false,
      "defaultValue": "/data/exports",
      "exampleValue": "/data/exports"
    },
    {
      "key": "PIPELINE_LOG_DIR",
      "description": "Directory path where pipeline log files are written.",
      "required": false,
      "secret": false,
      "defaultValue": "/data/logs",
      "exampleValue": "/data/logs"
    },
    {
      "key": "PIPELINE_DAILY_BUDGET_USD",
      "description": "Maximum Bright Data spend per pipeline run in USD. Run halts if exceeded.",
      "required": false,
      "secret": false,
      "defaultValue": "50",
      "exampleValue": "50"
    },
    {
      "key": "NOTIFICATION_WEBHOOK_URL",
      "description": "Optional webhook URL to receive run-complete and error notifications.",
      "required": false,
      "secret": false,
      "exampleValue": "https://hooks.slack.com/services/xxx/yyy/zzz"
    }
  ],
  "dockerComposeSnippet": {
    "description": "Add these under the 'environment' key of your n8n service in docker-compose.yml",
    "snippet": [
      "BRIGHTDATA_API_TOKEN=${BRIGHTDATA_API_TOKEN}",
      "BRIGHTDATA_CUSTOMER_ID=${BRIGHTDATA_CUSTOMER_ID}",
      "BRIGHTDATA_USERNAME=${BRIGHTDATA_USERNAME}",
      "BRIGHTDATA_PASSWORD=${BRIGHTDATA_PASSWORD}",
      "BRIGHTDATA_SERP_ZONE=${BRIGHTDATA_SERP_ZONE}",
      "BRIGHTDATA_MAPS_DATASET_ID=${BRIGHTDATA_MAPS_DATASET_ID}",
      "BRIGHTDATA_UNLOCKER_ZONE=${BRIGHTDATA_UNLOCKER_ZONE}",
      "BRIGHTDATA_UNLOCKER_HOST=brd.superproxy.io",
      "BRIGHTDATA_UNLOCKER_PORT=22225",
      "HUNTER_API_KEY=${HUNTER_API_KEY}",
      "PIPELINE_OUTPUT_DIR=/data/exports",
      "PIPELINE_LOG_DIR=/data/logs",
      "PIPELINE_DAILY_BUDGET_USD=50"
    ]
  }
}
