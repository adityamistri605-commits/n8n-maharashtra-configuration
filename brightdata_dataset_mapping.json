{
  "metadata": {
    "version": "1.0.0",
    "provider": "Bright Data",
    "website": "https://brightdata.com",
    "encoding": "UTF-8",
    "description": "Maps every Bright Data dataset and zone used in the pipeline. Reference these IDs in n8n HTTP Request nodes instead of hardcoding them inline."
  },
  "geography": {
    "country": "India",
    "countryCode": "IN",
    "state": "Maharashtra",
    "stateCode": "MH",
    "language": "en"
  },
  "datasets": {
    "googleMaps": {
      "datasetId": "gd_l7q7dkf244hwjntr0",
      "label": "Google Maps Business Listings",
      "description": "Scrapes Google Maps / Google My Business listings for a given search query and location.",
      "triggerEndpoint": "https://api.brightdata.com/datasets/v3/trigger",
      "snapshotEndpoint": "https://api.brightdata.com/datasets/v3/snapshot/{{snapshotId}}",
      "progressEndpoint": "https://api.brightdata.com/datasets/v3/progress/{{snapshotId}}",
      "expectedFields": [
        "name",
        "address",
        "phone",
        "website",
        "rating",
        "reviews",
        "category",
        "googleMapsUrl",
        "latitude",
        "longitude",
        "businessStatus"
      ],
      "estimatedCostPerRecordUsd": 0.003,
      "maxRecordsPerTrigger": 20
    },
    "googleBusinessProfile": {
      "datasetId": "gd_l1vikfnt1wgvvqz95w",
      "label": "Google Business Profile Detail",
      "description": "Fetches detailed Google Business Profile data for a specific business URL.",
      "triggerEndpoint": "https://api.brightdata.com/datasets/v3/trigger",
      "snapshotEndpoint": "https://api.brightdata.com/datasets/v3/snapshot/{{snapshotId}}",
      "progressEndpoint": "https://api.brightdata.com/datasets/v3/progress/{{snapshotId}}",
      "expectedFields": [
        "name",
        "description",
        "address",
        "phone",
        "website",
        "hours",
        "categories",
        "photos",
        "rating",
        "reviews"
      ],
      "estimatedCostPerRecordUsd": 0.004,
      "maxRecordsPerTrigger": 1
    },
    "googleSearch": {
      "datasetId": "gd_lz7z5y8k3hmfoo1m1y",
      "label": "Google SERP Results",
      "description": "Returns organic Google Search results for a given query.",
      "triggerEndpoint": "https://api.brightdata.com/datasets/v3/trigger",
      "snapshotEndpoint": "https://api.brightdata.com/datasets/v3/snapshot/{{snapshotId}}",
      "progressEndpoint": "https://api.brightdata.com/datasets/v3/progress/{{snapshotId}}",
      "expectedFields": [
        "title",
        "url",
        "description",
        "position",
        "type"
      ],
      "estimatedCostPerRecordUsd": 0.002,
      "maxRecordsPerTrigger": 10
    }
  },
  "zones": {
    "serpApi": {
      "zoneNameEnvVar": "BRIGHTDATA_SERP_ZONE",
      "defaultZoneName": "serp_api1",
      "baseUrl": "https://api.brightdata.com/serp",
      "label": "SERP API Zone",
      "description": "Used for real-time Google Search and Google Maps SERP calls."
    },
    "webUnlocker": {
      "zoneNameEnvVar": "BRIGHTDATA_UNLOCKER_ZONE",
      "defaultZoneName": "web_unlocker1",
      "proxyHost": "brd.superproxy.io",
      "proxyPort": 22225,
      "label": "Web Unlocker Zone",
      "description": "Used for scraping business websites through Bright Data's unlocker proxy."
    }
  },
  "authentication": {
    "apiTokenEnvVar": "BRIGHTDATA_API_TOKEN",
    "customerIdEnvVar": "BRIGHTDATA_CUSTOMER_ID",
    "usernameEnvVar": "BRIGHTDATA_USERNAME",
    "passwordEnvVar": "BRIGHTDATA_PASSWORD",
    "note": "All credentials must be set as n8n environment variables. Never hardcode credentials in a workflow node."
  }
}
